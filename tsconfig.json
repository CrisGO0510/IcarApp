{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "quasar"],
    "strict": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "isolatedModules": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "src": ["./src"],
      "src/*": ["./src/*"],
      "app": ["."],
      "app/*": ["./*"],
      "components": ["./src/components"],
      "components/*": ["./src/components/*"],
      "layouts": ["./src/layouts"],
      "layouts/*": ["./src/layouts/*"],
      "assets": ["./src/assets"],
      "assets/*": ["./src/assets/*"],
      "boot": ["./src/boot"],
      "boot/*": ["./src/boot/*"],
      "stores": ["./src/stores"],
      "stores/*": ["./src/stores/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "env.d.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "capacitor.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
